# Gmail / Google Workspace SMTP (same pattern as ai-locating)
# Create an App Password for hello@coloringdictionary.com, then fill SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@coloringdictionary.com
SMTP_PASS=
SMTP_FROM=hello@coloringdictionary.com
SMTP_SECURE=false

# Optional Big Search HITS drain
REGISTRY_INGEST_API_KEY=

# Owner Firestore seed (POST /api/owner/seed)
OWNER_SEED_TOKEN=
